# 값은 비워 둔다. 실제 값은 .env(커밋 금지)에만 넣는다. 주석은 값 뒤가 아니라 윗줄에 쓴다.

# Zabbix API 주소: .../api_jsonrpc.php 까지 (실서버 모드에서 필수)
ZABBIX_URL=
# 읽기 전용 계정의 API 토큰 (실서버 모드에서 필수)
ZABBIX_API_TOKEN=
# false/0/no/off 면 TLS 인증서 검사를 끈다. 비우면 검사 켬
ZABBIX_VERIFY_TLS=
# true 면 네트워크 없이 fixture 를 돌려준다
ZABBIX_MOCK=
# 목 모드 시나리오: default, demo, quiet, host_down, empty, outage (비우면 default)
ZABBIX_MOCK_SCENARIO=

# mcp-zabbix 서버 바인딩 (선택)
MCP_ZABBIX_HOST=
MCP_ZABBIX_PORT=
# 내부 호출 토큰 (선택). 켜면 Authorization: Bearer <INTERNAL_TOKEN> 필요
INTERNAL_TOKEN=
